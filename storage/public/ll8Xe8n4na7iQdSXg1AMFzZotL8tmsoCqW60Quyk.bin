@charset "utf-8";

html[lang|="en"] #serverselect { }

html[lang|="en"] #maincol { }

html[lang|="en"] #leftcol ul.cdmenu { width: 10em; }

q { font-style: italic; }

html[lang|="en"] q::before { content: "â€œ"; }

html[lang|="en"] q::after { content: "â€"; }

html[lang|="en"] q q::before { content: "â€˜"; }

html[lang|="en"] q q::after { content: "â€™"; }

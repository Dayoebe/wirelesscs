#serverselect li { list-style: none; display: inline; padding: 0px 1em; margin: 0px; }

#serverselect form p { margin: 0px; padding: 0px; line-height: 1; }

.lcol50 { float: left; width: 49%; font-size: 0.75em; margin: 0px; padding: 0px 0.5em 0px 0px; }

.lcol50 h2 { margin-top: 0px; }

.rcol50 { margin: 0px 0px 0px 51%; padding: 0px; font-size: 0.75em; }

#pageLang { position: relative; }

form#pageLang { display: inline; }

input:focus { background-color: rgb(255, 255, 203); }

.hidecss { display: none; }

.clear { clear: both; }

#clear { clear: both; border: 0px; height: 1px; display: block; }

.quicklist { list-style: none; font-size: 0.75em; margin: 2em 0px; padding: 0px; text-indent: 0px; line-height: 2em; }

.quicklist li { display: inline; }

.item p { margin: 0px; }

.item h2, .item p, .item ul { margin-right: 10px; }

.item h2, .item h3, .item h4, .item h5 { margin-top: 0px; }

.line { padding: 0px; width: auto; overflow: hidden; }

div.downloads { border-top: 0.17em solid rgb(51, 153, 0); margin: 1.33em 0px 0px; }

.downloads ul.downlist { margin: 0px; }

div.downloads .col50 { border-top: 0.15em solid rgb(51, 153, 0); }

ul.downlist { padding-left: 30px; text-indent: 0px; background: url("Pics/emblem-downloads.png") 0px 0.15em no-repeat; min-height: 23px; }

ul.quicklist.downlist { border-top: 0.17em solid rgb(51, 153, 0); padding-top: 0.25em; margin-top: 1.6em; }

ul.downlist li { display: inline; }

ul.downlist li::after { content: ", "; }

ul.downlist li:last-child::after { content: ""; }

ul.downlist li a { white-space: nowrap; }

div.tip, div.important, div.warning, div.note, div.trans-note { padding: 0px 2em 0px 4em; margin: 1.85em 0px; background-repeat: no-repeat; background-position: 0.5em 0.5em; font-size: 0.75em; line-height: 2em; background-color: rgb(255, 255, 203); border: 0.15em solid rgb(204, 204, 163); }

div.tip p, div.important p, div.warning p, div.note p, div.trans-note p { margin: 1em 0px; }

div.tip { background-image: url("Pics/admon-tip.png"); }

div.important { background-image: url("Pics/admon-important.png"); }

div.warning { background-image: url("Pics/admon-warning.png"); }

div.note, div.trans-note { background-image: url("Pics/admon-note.png"); }

.col50, .cardleft, .cardright { width: 47.5%; float: left; padding-bottom: 1.5em; }

.lastcol, .cardright { margin: auto auto auto 5%; width: 47.5%; float: left; padding-right: 0px; }

.lastcol h2, .lastcol p, .lastcol ul { margin-right: 0px; }

.cardleft h2 { margin-right: 1em; }

.cardright div { margin-left: 1.5em; }

.cardright h2 { margin-left: 1em; }

.votemenu a { display: block; }

table.vote td, table.vote th { padding-right: 1.5em; }

#maincol.with-toolbox { margin-right: 14em; }

div.tabular table, table.tabular, table.vendors { border-bottom: 0.15em solid rgb(102, 102, 102); border-top: 0.15em solid rgb(102, 102, 102); font-size: 0.75em; margin-bottom: 4em; margin-top: -0.169em; text-align: left; width: 80%; }

table td { padding-right: 1.5em; padding-bottom: 0.5em; padding-top: 0.5em; line-height: 1.2em; border-top: 1px dotted grey; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; }

div.tabular table tr, table.tabular tr, table.vendors tr { width: 100%; }

table th { padding-right: 1.5em; padding-bottom: 0.5em; padding-top: 0.5em; line-height: 1.5em; }

div.tabular table td, table.tabular td, table.vendors td { border-top: 1px dotted grey; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; }

div.tabular table > td:first-child, table.tabular > td:first-child, table.vendors > td:first-child { background-image: none; }

#pageLang p, #pageLang form { display: inline; }

.inline a { float: left; margin-right: 1em; }

#langSelector { }

#langSelector:hover { }

#langContainer { padding-top: 0.5em; }

#langContainer a { margin-right: 1em; }

#pageLang:hover #langContainer { display: block; }

.partnerlogo { max-width: 200px; }

.bidi { direction: rtl; text-align: right; }

ul.nodecoration { list-style: none; padding: 0px; }

.action-block-form { margin-left: 4em; }

@media only screen and (max-width: 38em) {
  div#header { margin: 0px 2px; padding: 0px; }
  div#logo { position: relative; top: 0px; height: auto; margin: 0px; padding: 0px; min-height: 0px; }
  div#logo a { height: 61px; }
  div#logo a img { margin: 0px; padding: 0px; display: block; }
  #upperheader p.section { left: 70px; top: 0px; }
  div#searchbox { position: relative; margin: -31px 0px 0px 60px; float: right; bottom: 0px; padding: 0px; }
  div#searchbox input[name="P"] { width: 200px; }
  div#navbar { display: block; position: relative; clear: both; }
  #navbar ul { min-height: 1.5em; display: block; }
  #navbar li { display: inline; float: none; margin: 0px; padding: 0px; }
  div#navbar a:link, div#navbar a:visited { display: inline; margin: 0px 1.5em 0px 0px; padding: 0.25em 0px; border: 0px; background-color: transparent; }
  div#content { margin: 0px 2px; }
  ul.toc { max-width: none; }
  div#maincol { margin-right: 0px; }
  div.tip, div.important, div.warning, div.note, div.trans-note { overflow: hidden; }
  div.trans-note { position: relative; top: 0px; right: 0px; left: 0px; margin: 0px; background-image: none; padding: 0px 0px 0px 1em; }
  div#second-nav { margin-left: 1em; width: auto; }
  div#footer { margin-left: 10px; padding-left: 0px; padding-right: 0px; }
}

aside { float: right; width: 30%; margin: 0px 1.5%; padding-left: 10px; padding-right: 10px; font-style: italic; background-color: rgb(210, 211, 215); }

aside.light { float: right; width: 20%; margin: 0px 1.5%; padding: 15px; text-align: center; background-color: rgb(255, 255, 255); }
